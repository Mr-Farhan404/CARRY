# ==============================================================================
# CARRY Backend Environment Variables Template (Production & Staging)
# DO NOT commit real secrets here.
# ==============================================================================

# Active Spring Profile (Set to 'prod' for production deployment)
SPRING_PROFILES_ACTIVE=prod

# Production Database Connection
DB_URL=jdbc:mysql://<db-host>:<db-port>/<db-name>?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_production_db_username
DB_PASSWORD=your_production_db_password

# JWT Signing Secret (must be a strong 256-bit+ random secret in production)
JWT_SECRET=your_production_jwt_secret_min_256_bits_long

# Exact Production Frontend Origin for CORS (e.g. https://carry.vercel.app - no wildcard, no trailing slash)
FRONTEND_URL=https://your-frontend-domain.com

# Server Port (optional, default: 8080 or assigned by cloud PaaS)
PORT=8080
